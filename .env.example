# Copy to .env.local. Never commit real keys.

# Shared saving (optional for login, needed so phones share one book).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nix defaults to NixIsTheBest if unset.
NIX_PASSWORD=NixIsTheBest

# Required for Caleb to log in.
CALEB_PASSWORD=
