# Copy to .env.local. Never commit real keys.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server only. Used to create the Caleb and Nix logins.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nix defaults to NixIsTheBest if unset.
NIX_PASSWORD=NixIsTheBest

# Required to create Caleb's login.
CALEB_PASSWORD=
